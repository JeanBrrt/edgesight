# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Données et modèles 
detection/data/*
!detection/data/.gitkeep
# Modèle final (fp32 + INT8, 416/512/896px, ~40 Mo) et checkpoint
# pré-entraîné (~10 Mo) :
detection/models/*
!detection/models/.gitkeep
!detection/models/*.onnx
!detection/models/pretrained/
!detection/models/pretrained/*.pth
# Vidéos/images de démo par défaut 
demo/assets/*
!demo/assets/.gitkeep
!demo/assets/custom/.gitkeep
!demo/assets/scenes/
!demo/assets/silhouettes/
!demo/assets/zone_previews/
agent/data/*
!agent/data/.gitkeep
# GGUF du LLM (~2 Go, dépasse largement la limite GitHub par fichier) --
# reste ignoré, voir README pour le lien de téléchargement.
agent/models/*
!agent/models/.gitkeep

# Third-Party 
detection/third_party/*
!detection/third_party/nanodet/
detection/third_party/nanodet/*
!detection/third_party/nanodet/config/
detection/third_party/nanodet/config/*
!detection/third_party/nanodet/config/*.yml
agent/third_party/

# Sorties des scripts nanodet (démo, entraînement)
workspace/

